{
  "extends": "@tsconfig/node20/tsconfig.json",
  "compilerOptions": {
    "outDir": "${configDir}/dist",
    "rootDir": "${configDir}/lib",
    "allowJs": true,
    "typeRoots": ["./node_modules/@types"],
    "types": ["node", "jest"],
    "resolveJsonModule": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "isolatedModules": true
  },
  "ts-node": {
    "files": true
  },
  "include": ["./lib/**/*"],
  // Test files sit next to their sources in lib/ so jest picks them up, but they
  // must not be compiled into dist/: the .ts ones reference test-runner globals
  // that @tsconfig/node20 excludes via "types": ["node"], and the .js ones
  // would still be emitted because allowJs is on. Shipping either would pull
  // jest/mocha into every consumer of the published package.
  "exclude": ["./lib/**/*.test.*"]
}
